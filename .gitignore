```gitignore
# Dependências
node_modules/

# Build de produção
dist/

# Arquivos de ambiente e segredos
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# Cache
.cache/
.eslintcache
*.tsbuildinfo

# Arquivos do sistema operacional
.DS_Store
Thumbs.db

# Configurações de editores
.vscode/*
!.vscode/extensions.json
.idea/

# Arquivos temporários
*.tmp
*.swp
```